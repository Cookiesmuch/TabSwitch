<Window
    x:Class="TabSwitch.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TabSwitch"
    Title="TabSwitch">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Height="40" Padding="16,0,0,0">
            <TextBlock Text="TabSwitch" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="32,8,32,24" Spacing="24" MaxWidth="720" HorizontalAlignment="Stretch">

                <StackPanel Spacing="4">
                    <TextBlock Text="Tablet driver switching" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.7" />
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="Behaviour" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch x:Name="AutoToggle" Header="Automatic switching" OnContent="On" OffContent="Off" />
                    <ComboBox x:Name="DefaultCombo" Header="Driver when no app rule matches" MinWidth="260">
                        <ComboBoxItem Content="OpenTabletDriver" />
                        <ComboBoxItem Content="XP-PEN" />
                    </ComboBox>
                    <NumberBox x:Name="DelayBox" Header="Switch delay (ms) - ignores brief focus changes" Minimum="0" Maximum="10000"
                               SmallChange="100" SpinButtonPlacementMode="Inline" Width="260" HorizontalAlignment="Left" />
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="Application rules" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap"
                               Text="When the focused app matches a rule, that driver is used. Anything else uses the default above." />
                    <ListView x:Name="RulesList" SelectionMode="None" MaxHeight="260"
                              BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:AppRule">
                                <Grid ColumnSpacing="12" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Exe}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind DriverIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="OpenTabletDriver" />
                                        <ComboBoxItem Content="XP-PEN" />
                                    </ComboBox>
                                    <Button Grid.Column="2" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            Tag="{x:Bind}" Click="RemoveRule_Click" ToolTipService.ToolTip="Remove rule" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewExeBox" PlaceholderText="app.exe" />
                        <ComboBox x:Name="NewDriverCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="1">
                            <ComboBoxItem Content="OpenTabletDriver" />
                            <ComboBoxItem Content="XP-PEN" />
                        </ComboBox>
                        <Button Grid.Column="2" Content="Add" Click="AddRule_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button Grid.Column="3" Content="Pick running app...">
                            <Button.Flyout>
                                <Flyout x:Name="PickFlyout" Opening="PickFlyout_Opening" Placement="Bottom">
                                    <ListView x:Name="RunningList" Width="300" MaxHeight="320" SelectionMode="None"
                                              IsItemClickEnabled="True" ItemClick="RunningList_ItemClick" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="OpenTabletDriver" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OtdFolderBox" Header="Install folder" />
                        <Button Grid.Column="1" Content="Browse..." VerticalAlignment="Bottom" Click="BrowseOtd_Click" />
                    </Grid>
                    <ComboBox x:Name="PresetCombo" Header="Preset applied when switching to OTD" MinWidth="260" />
                    <ToggleSwitch x:Name="OtdUiToggle" Header="Also open the OTD config window after restarting" OnContent="Yes" OffContent="No" />
                    <ToggleSwitch x:Name="StopOtdToggle" Header="Stop OTD while in XP-PEN mode" OnContent="Yes" OffContent="No (keep running)" />
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="XP-PEN" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="XpExeBox" Header="XPPenTablet.exe" />
                        <Button Grid.Column="1" Content="Browse..." VerticalAlignment="Bottom" Click="BrowseXp_Click" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="System" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch x:Name="StartupToggle" Header="Start TabSwitch with Windows" OnContent="On" OffContent="Off" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="32,12" ColumnSpacing="8" BorderThickness="0,1,0,0"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SavedText" VerticalAlignment="Center" Opacity="0.7" />
            <Button Grid.Column="1" Content="Close" Click="Close_Click" />
            <Button Grid.Column="2" Content="Save" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Window>
